{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/experimental/0.9.0-research/schemas/authority-at-commitment.schema.json",
  "title": "Authority at Commitment (Experimental)",
  "description": "Experimental non-normative GAAM record binding a material commitment to current principal-derived authority, policy, constraints, approvals, and replayable decision evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "gaamVersion",
    "status",
    "normativeStatus",
    "principal",
    "actor",
    "mandate",
    "commitment",
    "evaluation",
    "decision"
  ],
  "properties": {
    "type": {
      "const": "authority-at-commitment"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "status": {
      "const": "experimental"
    },
    "normativeStatus": {
      "const": "non-normative"
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "authorityState"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "authorityState": {
          "enum": [
            "active",
            "restricted",
            "suspended",
            "revoked",
            "expired",
            "unknown"
          ]
        },
        "statusObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatedAt",
        "policyRef",
        "constraintResults",
        "approval"
      ],
      "properties": {
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        },
        "constraintResults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "constraint",
              "result"
            ],
            "properties": {
              "constraint": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "satisfied",
                  "failed",
                  "indeterminate"
                ]
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "bindingResult"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "approvalRef": {
              "type": "string",
              "minLength": 1
            },
            "commitmentDigest": {
              "type": "string",
              "pattern": "^sha256:[A-Fa-f0-9]{64}$"
            },
            "bindingResult": {
              "enum": [
                "not-required",
                "satisfied",
                "failed",
                "indeterminate"
              ]
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reasonCodes",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "permit",
            "deny",
            "indeterminate"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "permit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "mandate": {
            "properties": {
              "authorityState": {
                "const": "active"
              }
            }
          },
          "evaluation": {
            "properties": {
              "constraintResults": {
                "items": {
                  "properties": {
                    "result": {
                      "const": "satisfied"
                    }
                  }
                }
              },
              "approval": {
                "properties": {
                  "bindingResult": {
                    "enum": [
                      "not-required",
                      "satisfied"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
