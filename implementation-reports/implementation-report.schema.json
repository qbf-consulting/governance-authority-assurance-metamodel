{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gaam:schema:implementation-report:0.9.0",
  "title": "GAAM Implementation Report",
  "description": "Informative machine-readable evidence envelope for a GAAM implementation assessment. Validation does not itself establish conformance or independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "reportVersion",
    "reportStatus",
    "synthetic",
    "gaamVersion",
    "implementation",
    "profiles",
    "requirementsEvaluated",
    "evidenceLevel",
    "validator",
    "results",
    "exceptions",
    "evidenceManifest",
    "independence",
    "claimBoundary",
    "reassessmentTriggers"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^GAAM-IR-[A-Z0-9][A-Z0-9._-]*$"
    },
    "reportVersion": {
      "type": "string",
      "minLength": 1
    },
    "reportStatus": {
      "enum": [
        "submitted",
        "structurally-valid",
        "evidence-complete",
        "reviewed",
        "accepted",
        "superseded"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sourceRevision",
        "environment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 7
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "gaam:profile:foundation:0.9.0",
          "gaam:profile:delegated-authority:0.9.0",
          "gaam:profile:runtime-governance:0.9.0",
          "gaam:profile:agentic-systems:0.9.0",
          "gaam:profile:continuous-assurance:0.9.0",
          "gaam:profile:high-impact-systems:0.9.0",
          "gaam:profile:machine-actionable-governance:0.9.0",
          "gaam:profile:trust-graph:0.9.0"
        ]
      }
    },
    "requirementsEvaluated": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GAAM-[A-Z]+-[0-9]{3}$"
      }
    },
    "evidenceLevel": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/conformanceResult"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "mitigated",
              "accepted-risk",
              "closed"
            ]
          },
          "affectedRequirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^GAAM-[A-Z]+-[0-9]{3}$"
            }
          }
        }
      }
    },
    "evidenceManifest": {
      "type": "string",
      "minLength": 1
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "assessor",
        "relationshipsDisclosed",
        "statement"
      ],
      "properties": {
        "classification": {
          "enum": [
            "self",
            "second-party",
            "independent"
          ]
        },
        "assessor": {
          "type": "string",
          "minLength": 1
        },
        "relationshipsDisclosed": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "limitations",
        "validFrom",
        "validUntil"
      ],
      "properties": {
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "reassessmentTriggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decisionEvidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "conformanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "requirementId",
        "method",
        "status",
        "evidenceIds"
      ],
      "properties": {
        "resultId": {
          "type": "string",
          "minLength": 1
        },
        "requirementId": {
          "type": "string",
          "pattern": "^GAAM-[A-Z]+-[0-9]{3}$"
        },
        "method": {
          "enum": [
            "structural-test",
            "behavioural-test",
            "observation",
            "inspection",
            "review",
            "mixed"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "indeterminate",
            "not-applicable"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
