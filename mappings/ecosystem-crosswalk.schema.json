{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/mappings/ecosystem-crosswalk.schema.json",
  "title": "GAAM Informative Ecosystem Assessment Crosswalk",
  "description": "Informative schema for reproducible GAAM readiness mappings. It does not define GAAM conformance.",
  "type": "object",
  "required": ["id", "gaamVersion", "normativeStatus", "assessmentType", "target", "method", "findings", "limitations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "gaamVersion": {"const": "0.9.0"},
    "normativeStatus": {"const": "informative"},
    "assessmentType": {"const": "readiness-crosswalk"},
    "target": {
      "type": "object",
      "required": ["name", "version", "source", "assessedAt"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "format": "uri"},
        "assessedAt": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["statusVocabulary", "claimBoundary"],
      "properties": {
        "statusVocabulary": {
          "type": "array",
          "const": ["covered", "partial", "gap", "not-applicable", "unknown"]
        },
        "claimBoundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "gaamRequirements", "observation", "actionableTakeaway", "evidenceExpectation", "candidateTests"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["covered", "partial", "gap", "not-applicable", "unknown"]},
          "gaamRequirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^GAAM-[A-Z]+-[0-9]{3}$"}
          },
          "observation": {"type": "string", "minLength": 1},
          "actionableTakeaway": {"type": "string", "minLength": 1},
          "evidenceExpectation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "candidateTests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
