{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gaam:schema:candidate-readiness:0.9.0",
  "title": "GAAM Candidate Readiness State",
  "type": "object",
  "additionalProperties": false,
  "required": ["gaamVersion", "generatedFrom", "eligibleForV1Decision", "acceptedImplementationReports", "blockingGates", "gates"],
  "properties": {
    "gaamVersion": {"const": "0.9.0"},
    "generatedFrom": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "eligibleForV1Decision": {"type": "boolean"},
    "acceptedImplementationReports": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blockingGates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "state", "blocking", "evidence", "closurePredicate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "state": {"enum": ["satisfied", "in-progress", "not-satisfied", "blocked"]},
          "blocking": {"type": "boolean"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "closurePredicate": {"type": "string", "minLength": 1},
          "sourceIssues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
