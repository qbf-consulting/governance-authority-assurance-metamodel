{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gaam:schema:candidate-readiness:0.9.0",
  "title": "GAAM Maturity and Evidence State",
  "type": "object",
  "additionalProperties": false,
  "required": ["gaamVersion", "maturityModel", "gateClassification", "specification", "evidence", "gates"],
  "properties": {
    "gaamVersion": {"const": "0.9.0"},
    "maturityModel": {"const": "governance/maturity-model.json"},
    "gateClassification": {"const": "governance/v1-gate-classification.json"},
    "specification": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibleForStableDecision", "blockingGates", "knownBlockingFindings"],
      "properties": {
        "eligibleForStableDecision": {"type": "boolean"},
        "blockingGates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "knownBlockingFindings": {"type": "array", "items": {"type": "object"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "acceptedImplementationReports", "independentImplementationEvidenceSatisfied", "independentReviewEvidenceSatisfied", "crossImplementationEvidenceSatisfied"],
      "properties": {
        "level": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
        "acceptedImplementationReports": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "independentImplementationEvidenceSatisfied": {"type": "boolean"},
        "independentReviewEvidenceSatisfied": {"type": "boolean"},
        "crossImplementationEvidenceSatisfied": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "state", "controlBoundary", "blocksSpecificationStable", "evidenceLevel", "proves", "evidence", "closurePredicate", "sourceIssues"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "state": {"enum": ["satisfied", "in-progress", "not-satisfied", "blocked"]},
          "controlBoundary": {"enum": ["repository-controlled", "shared", "external"]},
          "blocksSpecificationStable": {"type": "boolean"},
          "evidenceLevel": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
          "proves": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "closurePredicate": {"type": "string", "minLength": 1},
          "sourceIssues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
