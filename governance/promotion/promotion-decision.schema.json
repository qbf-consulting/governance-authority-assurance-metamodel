{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/governance/promotion/promotion-decision.schema.json",
  "title": "GAAM Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "type",
    "gaamVersion",
    "candidateId",
    "decision",
    "decidedBy",
    "decidedAt",
    "evidence",
    "releaseImpact",
    "conditions",
    "supersessionOrRollback"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "pattern": "^(GAAM-PD-[0-9]{3}|PD-ILLUSTRATIVE-[0-9]{3})$"
    },
    "type": {
      "const": "gaam-promotion-decision"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^(GAAM-PC-[0-9]{3}|PC-ILLUSTRATIVE-[0-9]{3})$"
    },
    "decision": {
      "enum": [
        "accepted",
        "deferred",
        "rejected"
      ]
    },
    "decidedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "scope"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 3
        },
        "scope": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "decidedAt": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "releaseImpact": {
      "enum": [
        "commit-only",
        "release-required"
      ]
    },
    "targetVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersessionOrRollback": {
      "type": "string",
      "minLength": 10
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    }
  }
}
